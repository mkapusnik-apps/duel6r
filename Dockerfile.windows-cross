# syntax=docker/dockerfile:1
# Toolchain refresh revision: 1 (bump to refresh upstream packages)

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        g++-mingw-w64-x86-64 \
        gcc-mingw-w64-x86-64 \
        git \
        mingw-w64-tools \
        ninja-build \
        pkg-config \
        python3 \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

ARG VCPKG_REVISION=9e593bb18ea69cc5095e012465dcd675a822ed0d
RUN git clone https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && cd /opt/vcpkg \
    && git checkout "${VCPKG_REVISION}" \
    && ./bootstrap-vcpkg.sh -disableMetrics

RUN /opt/vcpkg/vcpkg install --triplet x64-mingw-dynamic \
        sdl2 \
        sdl2-image \
        'sdl2-mixer[libmodplug]' \
        sdl2-ttf \
        glew \
        'curl[core,ssl,c-ares]' \
        openssl \
        lua

COPY docker/mbedtls /opt/duel6r-mbedtls
RUN cmake -S /opt/duel6r-mbedtls -B /opt/mbedtls-build \
        -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_SYSTEM_PROCESSOR=x86_64 \
        -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/mbedtls-mingw \
    && cmake --build /opt/mbedtls-build --parallel 4 \
    && cmake --install /opt/mbedtls-build

WORKDIR /workspace

ENTRYPOINT ["bash", "/workspace/docker/build-windows.sh"]
