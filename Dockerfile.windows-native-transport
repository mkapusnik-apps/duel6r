# escape=`

FROM mcr.microsoft.com/dotnet/framework/runtime:4.8.1-windowsservercore-ltsc2025

ARG CMAKE_VERSION=3.31.8
ARG NINJA_VERSION=1.12.1
ARG PYTHON_VERSION=3.13.5

SHELL ["powershell", "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]

RUN $ErrorActionPreference = 'Stop'; `
    Invoke-WebRequest -UseBasicParsing "https://github.com/Kitware/CMake/releases/download/v${env:CMAKE_VERSION}/cmake-${env:CMAKE_VERSION}-windows-x86_64.zip" -OutFile C:\cmake.zip; `
    Expand-Archive C:\cmake.zip C:\Tools; `
    Move-Item "C:\Tools\cmake-${env:CMAKE_VERSION}-windows-x86_64" C:\Tools\cmake; `
    Remove-Item C:\cmake.zip; `
    New-Item -ItemType Directory -Force C:\Tools\ninja | Out-Null; `
    Invoke-WebRequest -UseBasicParsing "https://github.com/ninja-build/ninja/releases/download/v${env:NINJA_VERSION}/ninja-win.zip" -OutFile C:\ninja.zip; `
    Expand-Archive C:\ninja.zip C:\Tools\ninja; `
    Remove-Item C:\ninja.zip; `
    Invoke-WebRequest -UseBasicParsing "https://www.python.org/ftp/python/${env:PYTHON_VERSION}/python-${env:PYTHON_VERSION}-amd64.exe" -OutFile C:\python.exe; `
    $process = Start-Process C:\python.exe -ArgumentList '/quiet InstallAllUsers=1 TargetDir=C:\Python313 Include_pip=0 Include_launcher=0 Include_test=0 Shortcuts=0' -Wait -PassThru; `
    if ($process.ExitCode -ne 0) { throw "Python installation failed with exit code $($process.ExitCode)" }; `
    Remove-Item C:\python.exe

RUN $ErrorActionPreference = 'Stop'; `
    Invoke-WebRequest -UseBasicParsing 'https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2' -OutFile C:\mbedtls.tar.bz2; `
    if ((Get-FileHash C:\mbedtls.tar.bz2 -Algorithm SHA256).Hash -ne 'a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6') { throw 'Mbed TLS archive checksum mismatch' }; `
    New-Item -ItemType Directory -Force C:\Tools\mbedtls-source | Out-Null; `
    tar -xf C:\mbedtls.tar.bz2 -C C:\Tools\mbedtls-source --strip-components=1; `
    if ($LASTEXITCODE -ne 0) { throw 'Mbed TLS extraction failed' }; `
    Remove-Item C:\mbedtls.tar.bz2

COPY docker/mbedtls C:\Tools\duel6r-mbedtls

WORKDIR C:\workspace

COPY docker/build-windows-native-transport.cmd C:\Tools\build-windows-native-transport.cmd

ENTRYPOINT ["cmd", "/S", "/C", "C:\\Tools\\build-windows-native-transport.cmd"]
